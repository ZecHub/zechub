{
  "version": 1,
  "terms": [
    {
      "id": "wallet",
      "english": "wallet",
      "pos": "noun",
      "definition": "App or device that holds the keys to your coins and lets you send and receive them.",
      "match": [
        "wallet",
        "wallets",
        "Wallet",
        "Wallets"
      ],
      "examples": [
        "Download a Zcash wallet."
      ],
      "category": "concept",
      "default_policy": "translate",
      "applies_to": "both"
    },
    {
      "id": "shielded",
      "english": "shielded",
      "pos": "adjective",
      "definition": "Protected by Zcash's zero-knowledge encryption: a shielded address, transaction or pool hides sender, receiver and amount.",
      "not_to_be_confused_with": "encrypted (generic). Translate 'encrypted' normally.",
      "match": [
        "shielded",
        "Shielded",
        "unshielded",
        "Unshielded"
      ],
      "examples": [
        "Send ZEC to a shielded address.",
        "The Orchard shielded pool"
      ],
      "category": "protocol",
      "default_policy": "translate",
      "applies_to": "both"
    },
    {
